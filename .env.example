# Copy to .env (never commit .env). PRD §14 rule 4.

# LLM (extraction, judges, sampling) — PRD §19 Q3
ANTHROPIC_API_KEY=
REIGNS_MODEL=claude-sonnet-5
# Faster model for claim extraction (latency). Leave empty to use REIGNS_MODEL.
REIGNS_FAST_MODEL=claude-haiku-4-5
OPENAI_API_KEY=

# Search for Claim Verifier — PRD §19 Q2 (Tavily default)
# Claim Verifier web search: free key at https://tavily.com
TAVILY_API_KEY=
BRAVE_API_KEY=

# MongoDB Atlas learning store (FR-L1)
MONGODB_URI=

# Embeddings for experience memory (FR-L3, §19 Q6)
VOYAGE_API_KEY=

# ElevenLabs voice (FR-V1)
ELEVENLABS_API_KEY=
REIGNS_VOICE_ID=
# Optional: ElevenLabs model (default eleven_flash_v2_5 = lowest latency)
REIGNS_VOICE_MODEL=
# full (default) = read the whole bubble aloud; short = only the headline at level 3-4 (PRD)
REIGNS_VOICE_MODE=full
# Talking speed 0.7-1.2 (default 1.2 = fastest; 1.0 = ElevenLabs normal)
REIGNS_VOICE_SPEED=1.2
# Personality: cowboy (default) or plain. Lower stability = livelier delivery (0-1, default 0.35)
REIGNS_VOICE_STYLE=cowboy
REIGNS_VOICE_STABILITY=0.35
# Say a short "good job" when a checked reply has no problems (1 = on, 0 = off)
REIGNS_VOICE_PRAISE=1

# Reference Auditor: contact email gets Crossref's faster 'polite pool' (fewer 429s)
CROSSREF_MAILTO=
# Reference Auditor: without a key Semantic Scholar rate-limits almost every call (slow + misses).
# Free key: https://www.semanticscholar.org/product/api  ("Request an API key")
SEMANTIC_SCHOLAR_API_KEY=

# Engine
REIGNS_DB=reigns.db
REIGNS_PORT=8765
REIGNS_DETECTOR_TIMEOUT_S=12
